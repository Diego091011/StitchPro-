{
  "name": "stitchpro",
  "version": "1.0.0",
  "description": "Cotización, costos y pedidos para talleres de confección",
  "author": "StitchPro",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0" },
  "build": {
    "appId": "com.stitchpro.app",
    "productName": "StitchPro",
    "files": ["main.js", "*.html", "assets/**/*", "js/**/*"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}